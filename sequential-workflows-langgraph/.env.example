# Copy this file to ".env" and fill in your key.
#   cp .env.example .env
#
# The examples use OpenAI by default. Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# --- Want to use Anthropic / Claude instead? ---
# 1. pip install langchain-anthropic
# 2. set the key below
# 3. in any script, change the model string, e.g.
#    model="anthropic:claude-haiku-4-5"   instead of   "openai:gpt-4o-mini"
# ANTHROPIC_API_KEY=sk-ant-your-key-here
